# Copy this file to .env and fill in your own values.
# Never commit .env or share your Onshape secret key.
ENVIRONMENT=development
DEBUG=false
ALLOWED_ORIGINS=["http://localhost:5173"]

ONSHAPE_BASE_URL=https://cad.onshape.com/api
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=

# Choose: ollama or cloud
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b
CLOUD_AI_BASE_URL=https://api.openai.com/v1
CLOUD_AI_API_KEY=
CLOUD_AI_MODEL=gpt-4.1-mini

ONSHAPE_REQUEST_TIMEOUT_SECONDS=30
ONSHAPE_GET_CACHE_TTL_SECONDS=30
ONSHAPE_MAX_CONCURRENT_REQUESTS=2
